# Local launch: set these variables in your shell; copying this file does not export it.
APP_ENV=development
AUTH_MODE=demo
BIND_HOST=127.0.0.1
DATABASE_PATH=data/timeline.db
COOKIE_SECURE=false
FRONTEND_URL=http://127.0.0.1:5173
# Production Compose requires HTTPS values and a configured identity provider.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback
OIDC_ROLE_CLAIM=realm_access.roles
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
SESSION_TTL_SECONDS=28800
MAX_UPLOAD_BYTES=5242880
